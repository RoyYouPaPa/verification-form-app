# ------------------------------------------------------------
# 環境變數範例。複製成 .env（或 .env.local）後修改即可。
# 全部都是前端 build 時注入，會被打包進 bundle，請勿放真正機密。
# ------------------------------------------------------------

# 進站密碼（前端 gate 用）。未設定時預設 verify2026。
# 注意：這只是擋一般人瀏覽，不是強資安機制。
VITE_APP_PASSWORD=verify2026

# 部署 base path。
# 本機 / 自訂網域用 "/"。
# GitHub Pages「專案頁」需設成 "/repo-name/"（含前後斜線）。
VITE_BASE=/

# ------------------------------------------------------------
# 儲存後端切換。預設 none = 產完 PDF 就結束，不做任何網路請求。
#   none     ：不儲存（預設）
#   supabase ：Supabase（stub，尚未接上）
#   rest     ：通用 REST API（stub，尚未接上）
# 想開始儲存：把 VITE_STORAGE_MODE 改成 supabase 或 rest，
# 填好對應變數，並完成 src/storage/index.ts 內的 TODO。
# ------------------------------------------------------------
VITE_STORAGE_MODE=none

# --- 若 VITE_STORAGE_MODE=supabase 才需要 ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 若 VITE_STORAGE_MODE=rest 才需要 ---
VITE_STORAGE_API_URL=
